{
  "name": "cashin-appium-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Pruebas de interfaz Android para CashIn",
  "type": "module",
  "scripts": {
    "server": "appium",
    "doctor": "appium driver doctor uiautomator2",
